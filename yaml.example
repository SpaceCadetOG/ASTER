# Copy this file to `.aster.yaml` (already gitignored) and fill values.
#
# Auth modes:
# - agent => Aster Pro / Futures V3 wallet-sign mode (primary live path)
# - hmac  => legacy fallback only
# - auto  => chooses agent if user/signer/private_key/chain_id exist, else hmac

# Common
aster_auth_mode: agent
aster_base_url: https://fapi.asterdex.com

# Agent-wallet credentials (v3 style)
aster_user: 0xYOUR_MAIN_WALLET
aster_signer: 0xYOUR_APPROVED_API_WALLET
aster_private_key: 0xYOUR_SIGNER_PRIVATE_KEY
aster_chain_id: 1666

# Legacy HMAC fallback only. Leave blank for normal live agent mode.
# aster_api_key: YOUR_LEGACY_API_KEY
# aster_api_secret: YOUR_LEGACY_API_SECRET

# Notes:
# - `aster_user` = main wallet address
# - `aster_signer` = approved API wallet / agent
# - `aster_private_key` must derive to `aster_signer`
# - For live ops, keep `aster_user` and `aster_signer` separate unless you deliberately choose otherwise.

# Optional telegram fields used by cmd/live auto-notifications:
# telegram_bot_token: 123456:ABCDEF...
# telegram_chat_id: 123456789

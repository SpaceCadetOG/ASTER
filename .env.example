# --- Aster Pro agent auth (primary live path) ---
ASTER_AUTH_MODE=agent
ASTER_USER=0xyour_main_wallet
ASTER_SIGNER=0xyour_approved_api_wallet
ASTER_PRIVATE_KEY=0xyour_signer_private_key
ASTER_CHAIN_ID=1666
ASTER_BASE_URL=https://fapi.asterdex.com

# `user` = main wallet
# `signer` = approved API wallet / agent
# `ASTER_PRIVATE_KEY` must belong to `ASTER_SIGNER`
# For live deployments, prefer separate user and signer wallets for operational security.

# --- Legacy HMAC fallback only (leave unset for normal live agent mode) ---
ASTER_API_KEY=
ASTER_API_SECRET=

# --- Optional runtime ---
ASTER_CONFIG=
EXEC_BASE_URL=https://fapi.asterdex.com
ASTER_AUTH_DEBUG=0

# Do not set both agent and HMAC credentials in live mode unless you are intentionally testing fallback behavior.

# --- Optional Telegram ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Early continuation and soft-exit churn guards ---
LIVE_LEVERAGE_MODE=fixed
LIVE_LEVERAGE_FIXED=5
LIVE_MAX_LEVERAGE=5
LIVE_LEVERAGE_MIN=2
LIVE_EARLY_CONTINUATION_MIN_R=0.35
LIVE_EARLY_CONTINUATION_MIN_HOLD_MIN=8
LIVE_NO_FOLLOW_THROUGH_TIGHTEN_R=0.10
LIVE_NO_FOLLOW_THROUGH_TIGHTEN_R_WEAK=0.05
LIVE_PROFIT_GIVEBACK_TIGHTEN_R_EARLY=0.05
LIVE_REENTRY_SOFT_EXIT_COOLDOWN_MIN=20
LIVE_REENTRY_REQUIRE_STRONGER_SCORE_AFTER_SOFT_EXIT=true
LIVE_REENTRY_SOFT_EXIT_STRONGER_SCORE_DELTA=7.5
LIVE_CONTEXT_ONLY_SYMBOLS=
LIVE_CONTEXT_TRADEABLE_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT

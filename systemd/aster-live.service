[Unit]
Description=Aster Live Runner
After=network-online.target
Wants=network-online.target
Conflicts=go-machine.service

[Service]
Type=simple
User=traderbot
Group=traderbot
WorkingDirectory=/opt/aster
EnvironmentFile=-/opt/aster/env/live.env
ExecStart=/usr/bin/flock -n /tmp/aster-live.lock /opt/aster/bin/live
Restart=always
RestartSec=2
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target

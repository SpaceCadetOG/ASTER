[Unit]
Description=Aster Orderflow Score Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=traderbot
Group=traderbot
WorkingDirectory=/opt/aster
EnvironmentFile=-/opt/aster/env/oflow.env
ExecStart=/opt/aster/bin/oflow
Restart=always
RestartSec=2
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target

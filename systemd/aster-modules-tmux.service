[Unit]
Description=Aster tmux module supervisor (live-like local runtime)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=traderbot
Group=traderbot
WorkingDirectory=/opt/aster
ExecStart=/bin/bash -lc '/opt/aster/scripts/start_tmux_modules.sh; while true; do /opt/aster/scripts/start_tmux_modules.sh; sleep 30; done'
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target

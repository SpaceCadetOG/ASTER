[Unit]
Description=Aster Live Lite Runner
After=network-online.target
Wants=network-online.target
Conflicts=go-machine.service

[Service]
Type=simple
User=traderbot
Group=traderbot
WorkingDirectory=/opt/aster
EnvironmentFile=-/opt/aster/env/live-lite.env
ExecStart=/usr/bin/flock -n /tmp/aster-live-lite.lock /opt/aster/bin/live-lite
Restart=always
RestartSec=2
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target

[Unit]
Description=Aster Live Lite Runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=traderbot
Group=traderbot
WorkingDirectory=/opt/aster
EnvironmentFile=-/opt/aster/env/live-lite.env
ExecStart=/opt/aster/bin/live-lite
Restart=always
RestartSec=2
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target

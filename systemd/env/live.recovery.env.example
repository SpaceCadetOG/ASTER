# Minimal pre-ground-zero live-engine recovery env.
# Keep credentials in ASTER_CONFIG. Start with scripts/run_live_logged.sh.
ASTER_CONFIG=/etc/aster/.aster.yaml
EXEC_BASE_URL=https://fapi.asterdex.com
ASTER_AUTH_MODE=agent
ASTER_LOG_DIR=/opt/aster/logs
LIVE_STATE_DIR=/opt/aster/state

# Start in paper mode. Promote all three mode lines together after validation.
LIVE_RUNTIME_MODE=paper
LIVE_DRY_RUN=1
LIVE_ENABLE_LIVE_TRADING=0

# Fixed small-account sizing. Avoid dynamic sizing and pyramiding during recovery.
LIVE_TRADE_MARGIN_MODE=fixed
LIVE_TRADE_MARGIN_USDT=10
LIVE_TRADE_MARGIN_MIN_USDT=10
LIVE_TRADE_MARGIN_MAX_USDT=10
LIVE_STARTER_USDT=10
LIVE_ENTRY_STARTER_USDT=10
LIVE_ADD_USDT=10
LIVE_MAX_TOTAL_USDT=10
LIVE_PYRAMID_MAX_ADDS=0
LIVE_RISK_SIZING_ENABLE=0
LIVE_RESERVE_MODE=fixed
LIVE_RESERVE_USDT=20
LIVE_MIN_AVAILABLE_USDT=30

# One clean idea at a time while behavior is compared with trusted windows.
LIVE_SIMPLE_MODE=true
LIVE_MAX_OPEN_POS=1
LIVE_MAX_OPEN_PER_SIDE=1
LIVE_TRADE_SLOTS=1
LIVE_MAX_ORDERS_PER_DAY=3
LIVE_MAX_ORDERS_PER_HOUR=1
LIVE_ORDER_COOLDOWN_SEC=1800
LIVE_SYMBOL_COOLDOWN_SEC=21600
LIVE_MIN_GRADE=A
LIVE_MIN_ENTRY_CONF=0.62
LIVE_LEVERAGE_MODE=fixed
LIVE_LEVERAGE_FIXED=2
LIVE_LEVERAGE_MIN=2
LIVE_MAX_LEVERAGE=2
LIVE_MAX_DAILY_LOSS_PCT=1.5

# Recovery safety invariants.
LIVE_ALLOW_UNHEALTHY_ACCOUNT_AUTH=0
LIVE_REENTRY_ENABLE=0
LIVE_IMPORT_AUTO_MANAGE_ENABLE=0
LIVE_IMPORT_REQUIRE_PROTECTION=1
LIVE_STOP_ENGINE_V2_ENABLE=1
LIVE_STOP_TEMPLATE_MODE=setup
LIVE_STOP_TRIGGER_REF=mark
LIVE_TP_TRIGGER_REF=mark
LIVE_TRIGGER_PRICE_PROTECT=1

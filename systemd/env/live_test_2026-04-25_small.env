# April 25 small-account live function test
# Goal:
# - live trading enabled
# - exact $5 starter size
# - max 5 concurrent positions
# - fixed 2x leverage for initial safety
# - no pyramiding/adds

LIVE_DRY_RUN=0
LIVE_ENABLE_LIVE_TRADING=1

LIVE_SIMPLE_MODE=true

LIVE_TRADE_MARGIN_MODE=fixed
LIVE_TRADE_MARGIN_USDT=10
LIVE_TRADE_MARGIN_MIN_USDT=10
LIVE_TRADE_MARGIN_MAX_USDT=10

LIVE_STARTER_USDT=5
LIVE_ENTRY_STARTER_USDT=5
LIVE_ADD_USDT=5
LIVE_MAX_TOTAL_USDT=5
LIVE_PYRAMID_MAX_ADDS=0

LIVE_RISK_SIZING_ENABLE=0

LIVE_MAX_OPEN_POS=5
LIVE_MAX_OPEN_PER_SIDE=5
LIVE_TRADE_SLOTS=5

LIVE_LEVERAGE_MODE=fixed
LIVE_LEVERAGE_FIXED=2
LIVE_LEVERAGE_MIN=2
LIVE_MAX_LEVERAGE=5

LIVE_RESERVE_MODE=fixed
LIVE_RESERVE_USDT=5
LIVE_MIN_AVAILABLE_USDT=5

LIVE_MAX_ORDERS_PER_DAY=10
LIVE_MAX_ORDERS_PER_HOUR=5
LIVE_ORDER_COOLDOWN_SEC=300
LIVE_SYMBOL_COOLDOWN_SEC=1800

LIVE_MIN_GRADE=B
LIVE_B_NEAR_A_ONLY=true
LIVE_MIN_ENTRY_CONF=0.62

LIVE_ALLOW_UNHEALTHY_ACCOUNT_AUTH=0
LIVE_IMPORT_AUTO_MANAGE_ENABLE=0
LIVE_IMPORT_REQUIRE_PROTECTION=1

LIVE_STOP_ENGINE_V2_ENABLE=1
LIVE_STOP_TEMPLATE_MODE=setup
LIVE_STOP_TRIGGER_REF=mark
LIVE_TP_TRIGGER_REF=mark
LIVE_TRIGGER_PRICE_PROTECT=1

LIVE_SHOW_ACCOUNT=1
LIVE_ACCOUNT_ASSETS=USDT,BTC,USDF

LIVE_SCAN_SEC=20
LIVE_MIN_GRADE=B
LIVE_GRADE_TOP_N=6

# live-lite environment overrides
ASTER_CONFIG=/etc/aster/.aster.yaml
EXEC_BASE_URL=https://fapi.asterdex.com

LIVE_DRY_RUN=1
LIVE_ENABLE_LIVE_TRADING=0
LIVE_SHOW_ACCOUNT=1
LIVE_ACCOUNT_ASSETS=USDT,BTC,USDF

LIVE_SCAN_SEC=20
LIVE_MIN_GRADE=B
LIVE_GRADE_TOP_N=6
LIVE_ENTRY_OFFSET_BPS=2

LIVE_RESERVE_USDT=5
LIVE_TRADE_MARGIN_USDT=100
LIVE_MIN_AVAILABLE_USDT=15

LIVE_MAX_LEVERAGE=3
LIVE_MAX_ORDERS_PER_DAY=2
LIVE_ORDER_COOLDOWN_SEC=120
LIVE_ALLOW_SHORTS=0
LIVE_ALLOW_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
LIVE_PAUSE_FILE=/tmp/live-lite.pause

LIVE_TG_DEDUPE_SEC=30
LIVE_TG_HOURLY_ENABLE=1
LIVE_TG_HOURLY_TZ=America/Chicago
LIVE_TG_DIGEST_MIN=60
LIVE_TG_TRADE_UPDATE_MIN=60

LIVE_MARGIN_TYPE=ISOLATED
LIVE_ENFORCE_MARGIN_TYPE=1

LIVE_STALE_ENABLE=1
LIVE_STALE_MAX_AGE_MIN=180
LIVE_STALE_MIN_PROGRESS_R=0.25
LIVE_STALE_PROFIT_GRACE_R=0.75

LIVE_MIN_STOP_PCT=0.25
LIVE_MAX_STOP_PCT=8.00
LIVE_MIN_RR_TP1=0.80
LIVE_BE_LOCK_BPS=5

LIVE_MAINT_ENABLE=1
LIVE_MAINT_TZ=America/Chicago
LIVE_MAINT1_START_HOUR=0
LIVE_MAINT1_END_HOUR=1
LIVE_MAINT1_FORCE_FLAT=0
LIVE_MAINT1_HOOK=/opt/aster/scripts/maintenance_midnight.sh
LIVE_MAINT1_HOOK_TIMEOUT_SEC=900
LIVE_MAINT2_START_HOUR=16
LIVE_MAINT2_END_HOUR=17
LIVE_MAINT2_FORCE_FLAT=1
LIVE_MAINT2_HOOK=/opt/aster/scripts/maintenance_eod.sh
LIVE_MAINT2_HOOK_TIMEOUT_SEC=900

LIVE_PAPER_ENABLE=1
LIVE_PAPER_STATE_FILE=out/paper_state.json
LIVE_PAPER_OB_LEVELS=20
LIVE_PAPER_FEE_BPS=4.0
LIVE_PAPER_FEE_MAKER_BPS=0.5
LIVE_PAPER_FEE_TAKER_BPS=4.0
LIVE_PAPER_FUNDING_INTERVAL_MIN=480

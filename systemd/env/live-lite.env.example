LIVE_RESERVE_LOCK_RECOVERY_PCT=100

LIVE_MAX_LEVERAGE=3
LIVE_MAX_ORDERS_PER_DAY=2
LIVE_ORDER_COOLDOWN_SEC=120
LIVE_ALLOW_SHORTS=0

[Unit]
Description=Aster Tape (aggTrade stream printer)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=traderbot
Group=traderbot
WorkingDirectory=/opt/aster
EnvironmentFile=-/opt/aster/env/tape.env
ExecStart=/opt/aster/bin/tape
Restart=always
RestartSec=2
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target

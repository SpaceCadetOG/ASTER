[Unit]
Description=ASTER tape monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ogbebortrading
WorkingDirectory=/opt/aster/repo
EnvironmentFile=/opt/aster/env/tape.env
Environment=ASTER_LOG_DIR=/opt/aster/logs
ExecStart=/opt/aster/bin/tape
Restart=on-failure
RestartSec=5
SyslogIdentifier=aster-tape
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

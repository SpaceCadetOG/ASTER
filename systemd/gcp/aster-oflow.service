[Unit]
Description=ASTER orderflow monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ogbebortrading
WorkingDirectory=/opt/aster/repo
EnvironmentFile=/opt/aster/env/oflow.env
Environment=ASTER_LOG_DIR=/opt/aster/logs
ExecStart=/opt/aster/bin/oflow
Restart=on-failure
RestartSec=5
SyslogIdentifier=aster-oflow
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

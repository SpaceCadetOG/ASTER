[Unit]
Description=ASTER whale monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ogbebortrading
WorkingDirectory=/opt/aster/repo
EnvironmentFile=/opt/aster/env/whale.env
Environment=ASTER_LOG_DIR=/opt/aster/logs
ExecStart=/opt/aster/bin/whale
Restart=on-failure
RestartSec=5
SyslogIdentifier=aster-whale
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

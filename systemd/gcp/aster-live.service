[Unit]
Description=ASTER live runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ogbebortrading
WorkingDirectory=/opt/aster/repo
EnvironmentFile=/opt/aster/env/live.env
Environment=ASTER_LOG_DIR=/opt/aster/logs
ExecStart=/opt/aster/bin/live
Restart=on-failure
RestartSec=10
SyslogIdentifier=aster-live
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
